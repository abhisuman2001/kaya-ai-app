# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=AQ.Ab8RN6KkV9Wk3FUQLHuHZXdOrn3YcMoXk65LmJM8OCBi_sd2ig

# Comma-separated Gemini keys. Each free-tier key has its own quota, so the app
# rotates across them (see MultiAgentService) to multiply the usable budget.
# Real values live in .env, which is gitignored.
GEMINI_API_KEYS=

OPENWEATHER_API_KEY=45425267455f370ff8c2ed79dcde9ca3
# Note: Real-time weather works out-of-the-box via Open-Meteo without needing any API key!
# If you provide an OpenWeatherMap API key in the Secrets panel, it will be used as a primary source.

